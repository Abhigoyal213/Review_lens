# Server Configuration
PORT=5000

# Database Configuration (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/reviewlens

# AI Provider Selection: set to 'gemini' or 'claude'
AI_PROVIDER=gemini

# Option 1: Google Gemini API (Get free key from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option 2: FreeModel Claude API (from: https://freemodel.in/dashboard)
FREEMODEL_API_KEY=your_freemodel_api_key_here
FREEMODEL_BASE_URL=https://freemodel.in/v1
FREEMODEL_MODEL=claude-opus-4.8
